{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": ["src/**/*"],
  "exclude": ["node_modules/*", "src/to-do/*"],
  "compilerOptions": {
    "types": ["node", "svelte"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "src": ["src/*"]
    },
    "alwaysStrict": true,
    "noImplicitAny": true
  }
}